    }

    <!-- Filter by Status -->
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Filter by Status</h5>
            <div class="row">
                <div class="col-md-6">
                    <div class="btn-group" role="group">
                        <a asp-action="Index" class="btn btn-outline-secondary">All</a>
                        <a asp-action="FilterByStatus" asp-route-status="Open" class="btn btn-outline-warning">Open</a>
                        <a asp-action="FilterByStatus" asp-route-status="In Progress" class="btn btn-outline-info">In Progress</a>
                        <a asp-action="FilterByStatus" asp-route-status="Closed" class="btn btn-outline-success">Closed</a>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span class="text-muted">Total: @Model.Count() tickets</span>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No tickets found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Raised By</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td>@ticket.Id</td>
                            <td>@ticket.Title</td>
                            <td>
                                <span class="badge bg-@(ticket.Priority == "High" ? "danger" : ticket.Priority == "Medium" ? "warning" : "info")">
                                    @ticket.Priority
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-@(ticket.Status == "Open" ? "warning" : ticket.Status == "In Progress" ? "info" : "success")">
                                    @ticket.Status
                                </span>
                            </td>
                            <td>@ticket.RaisedBy</td>
                            <td>@ticket.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-primary">Edit</a>
                                <form asp-action="Delete" asp-route-id="@ticket.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this ticket?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
