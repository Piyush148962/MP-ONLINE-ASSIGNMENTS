namespace HelpDesk.Mvc.Controllers
{
    public class TicketController : Controller
    {
        private readonly ITicketService _ticketService;
        private readonly ILogger<TicketController> _logger;

        public TicketController(ITicketService ticketService, ILogger<TicketController> logger)
        {
            _ticketService = ticketService;
            _logger = logger;
        }

        public async Task<IActionResult> Dashboard()
        {
            try
            {
                var dashboardData = await _ticketService.GetDashboardDataAsync();
                return View(dashboardData);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error loading dashboard");
                return View(new DashboardViewModel());
            }
        }

        public async Task<IActionResult> Index()
        {
            try
            {
                var tickets = await _ticketService.GetAllTicketsAsync();
                return View(tickets);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error loading tickets index");
                return View(new List<Ticket>());
            }
        }

        public async Task<IActionResult> Details(int id)
        {
            try
            {
                var ticket = await _ticketService.GetTicketByIdAsync(id);
                if (ticket == null)
                {
                    TempData["ErrorMessage"] = $"Ticket with ID {id} not found";
                    return RedirectToAction(nameof(Index));
                }
                return View(ticket);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, $"Error loading ticket details for ID {id}");
                TempData["ErrorMessage"] = "An error occurred while loading ticket details";
                return RedirectToAction(nameof(Index));
            }
        }

        public IActionResult Create()
        {
            ViewBag.Priorities = TicketConstants.Priorities;
            ViewBag.Statuses = TicketConstants.Statuses;
            var ticket = new Ticket
            {
                Status = TicketConstants.StatusOpen, // Default status
                CreatedDate = DateTime.Now
            };
            return View(ticket);
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Create(Ticket ticket)
        {
            if (ModelState.IsValid)
            {
                try
                {
                    ticket.CreatedDate = DateTime.Now;
                    var success = await _ticketService.CreateTicketAsync(ticket);
                    if (success)
                    {
                        TempData["SuccessMessage"] = "Ticket created successfully";
                        return RedirectToAction(nameof(Index));
                    }
                    ModelState.AddModelError("", "Failed to create ticket");
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Error creating ticket");
                    ModelState.AddModelError("", "An error occurred while creating the ticket");
                }
            }

            ViewBag.Priorities = TicketConstants.Priorities;
            ViewBag.Statuses = TicketConstants.Statuses;
            return View(ticket);
        }

        public async Task<IActionResult> Edit(int id)
        {
            try
            {
                var ticket = await _ticketService.GetTicketByIdAsync(id);
                if (ticket == null)
                {
                    TempData["ErrorMessage"] = $"Ticket with ID {id} not found";
                    return RedirectToAction(nameof(Index));
                }

                ViewBag.Priorities = TicketConstants.Priorities;
                ViewBag.Statuses = TicketConstants.Statuses;
                return View(ticket);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, $"Error loading ticket for edit with ID {id}");
                TempData["ErrorMessage"] = "An error occurred while loading ticket for edit";
                return RedirectToAction(nameof(Index));
            }
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Edit(int id, Ticket ticket)
        {
            if (id != ticket.Id)
            {
                return NotFound();
            }

            if (ModelState.IsValid)
            {
                try
                {
                    var existingTicket = await _ticketService.GetTicketByIdAsync(id);
                    if (existingTicket == null)
                    {
                        TempData["ErrorMessage"] = $"Ticket with ID {id} not found";
                        return RedirectToAction(nameof(Index));
                    }

                    ticket.CreatedDate = existingTicket.CreatedDate;
                    var success = await _ticketService.UpdateTicketAsync(ticket);
                    if (success)
                    {
                        TempData["SuccessMessage"] = "Ticket updated successfully";
                        return RedirectToAction(nameof(Index));
                    }
                    ModelState.AddModelError("", "Failed to update ticket");
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, $"Error updating ticket with ID {id}");
                    ModelState.AddModelError("", "An error occurred while updating the ticket");
                }
            }

            ViewBag.Priorities = TicketConstants.Priorities;
            ViewBag.Statuses = TicketConstants.Statuses;
            return View(ticket);
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public async Task<IActionResult> Delete(int id)
        {
            try
            {
                var success = await _ticketService.DeleteTicketAsync(id);
                if (success)
                {
                    TempData["SuccessMessage"] = "Ticket deleted successfully";
                }
                else
                {
                    TempData["ErrorMessage"] = "Failed to delete ticket";
                }
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, $"Error deleting ticket with ID {id}");
                TempData["ErrorMessage"] = "An error occurred while deleting the ticket";
            }

            return RedirectToAction(nameof(Index));
        }

        public async Task<IActionResult> FilterByStatus(string status)
        {
            try
            {
                if (string.IsNullOrEmpty(status))
                {
                    return RedirectToAction(nameof(Index));
                }

                var tickets = await _ticketService.GetTicketsByStatusAsync(status);
                ViewBag.SelectedStatus = status;
                ViewBag.Statuses = TicketConstants.Statuses;
                return View("Index", tickets);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, $"Error filtering tickets by status: {status}");
                TempData["ErrorMessage"] = "An error occurred while filtering tickets";
                return RedirectToAction(nameof(Index));
            }
        }
    }
